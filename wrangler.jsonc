{
  "name": "personal-egor-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-26",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "qumcl.xeuqra.com", "custom_domain": true }]
}
